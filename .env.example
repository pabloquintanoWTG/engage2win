# Copy this file to ".env.local" and fill in real values.
# NEVER commit .env.local — it holds secrets. (.gitignore already excludes it.)

# --- Phase 0 (validation harness) ---
# Get a key at https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the default vision model used by validate/run.py
# MTT_MODEL=claude-sonnet-4-6

# --- Phase 1 app (app/) ---
# Flask session signing key. Generate one, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Optional: override the SQLite location (defaults to app/engage2win.db)
# DATABASE_URL=sqlite:///C:/path/to/engage2win.db
